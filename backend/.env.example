# PayPal sandbox app: developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Agent model provider: gemini (default) or anthropic
AGENT_PROVIDER=gemini
# Gemini: aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic (only if AGENT_PROVIDER=anthropic): console.anthropic.com
ANTHROPIC_API_KEY=

# Where PayPal redirects the owner after approving
PUBLIC_BASE_URL=http://localhost:8000

# Where the API redirects the owner after PayPal (the React dashboard)
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=spendguard.db

# Your sandbox *business* account email: it sells the demo catalog's items
DEMO_MERCHANT_EMAIL=

# Agent (optional overrides; empty = provider default)
AGENT_MODEL=
